<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <TextView
        android:id="@+id/tv_my_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/title_my_list"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_my_list_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3">

                <!-- Placeholder items for My List -->
                <ImageView
                    android:id="@+id/img_list_1"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/img_series_desc"
                    app:srcCompat="@drawable/ha" />

                <ImageView
                    android:id="@+id/img_list_2"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/img_series_desc"
                    app:srcCompat="@drawable/st" />

                <ImageView
                    android:id="@+id/img_list_3"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/img_series_desc"
                    app:srcCompat="@drawable/bb" />

                <ImageView
                    android:id="@+id/img_list_4"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/img_series_desc"
                    app:srcCompat="@drawable/rm" />

            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btn_back_my_list"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="12dp"
        android:background="@null"
        android:src="@drawable/seta"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"
        android:contentDescription="@string/btn_back_desc" />

</androidx.constraintlayout.widget.ConstraintLayout>